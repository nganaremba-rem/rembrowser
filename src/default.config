# rembrowser built-in defaults (compiled in). Loaded first; ~/.config/rembrowser/config
# (or ~/.config/vimb/config) loads after it and wins. Same syntax as vimb.

set home-page=home
set hint-keys=asdfghjkl
set incsearch=on
set scroll-step=60
set geolocation=never

# :open aw niri — plain words go to DuckDuckGo.
shortcut-add dd=https://duckduckgo.com/?q=$0
shortcut-add g=https://www.google.com/search?q=$0
shortcut-add gh=https://github.com/search?q=$0
shortcut-add aw=https://wiki.archlinux.org/index.php?search=$0
shortcut-add yt=https://www.youtube.com/results?search_query=$0
shortcut-add w=https://en.wikipedia.org/w/index.php?search=$0
shortcut-default dd

#: tabs picker
nnoremap <Space><Space> :tabs<CR>
#: recent pages (history)
nnoremap <Space>s. :history<CR>
#: bookmarks
nnoremap <Space>sm :bookmarks<CR>
#: search keymaps (this cheatsheet)
nnoremap <Space>sk :keys<CR>
#: downloads
nnoremap <Space>sd :downloads<CR>
#: bookmark this page (type tags, Enter)
nnoremap <Space>ba :bma<Space>
#: harpoon: add page
nnoremap <Space>ma :pin add<CR>
#: harpoon: menu
nnoremap <Space>mm :pins<CR>
#: harpoon: page 1
nnoremap <Space>1 :jump 1<CR>
#: harpoon: page 2
nnoremap <Space>2 :jump 2<CR>
#: harpoon: page 3
nnoremap <Space>3 :jump 3<CR>
#: harpoon: page 4
nnoremap <Space>4 :jump 4<CR>
#: pin / unpin the status line
nnoremap <Space>ul :set status-bar!<CR>
#: pin / unpin the tab bar
nnoremap <Space>ut :set tab-bar!<CR>
#: show / hide the bookmark bar
nnoremap <Space>ub :set bookmark-bar!<CR>
#: read later: list
nnoremap <Space>sq :queue<CR>
#: read later: push page
nnoremap <Space>. :qpush<CR>
#: read later: open oldest
nnoremap <Space>S :qpop<CR>
#: edit config.yaml
nnoremap <Space>uc :config<CR>
#: quit all
nnoremap <Space>q :quitall<CR>
#: extensions: manage (on/off, options)
nnoremap <Space>ee :extensions<CR>
#: extensions: open a popup
nnoremap <Space>ep :ext-popup<CR>
#: extensions: install from this Web Store page
nnoremap <Space>ei :ext-install<CR>
#: extensions: remove one
nnoremap <Space>ex :ext-remove<CR>
#: this page in a Chromium window (toolbar, extension buttons)
nnoremap <Space>ec :chrome<CR>
#: Chromium settings
nnoremap <Space>us :settings<CR>
